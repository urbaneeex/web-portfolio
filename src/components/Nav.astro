---
import { nav, menuSocials } from "../data/site";
---

<svg class="nav-glass-svg" aria-hidden="true" focusable="false">
  <filter
    id="glass-distortion"
    x="-5%"
    y="-20%"
    width="110%"
    height="140%"
    filterUnits="objectBoundingBox"
  >
    <feTurbulence
      type="fractalNoise"
      baseFrequency="0.01 0.01"
      numOctaves="1"
      seed="5"
      result="turbulence"
    />
    <feComponentTransfer in="turbulence" result="mapped">
      <feFuncR type="gamma" amplitude="1" exponent="10" offset="0.5" />
      <feFuncG type="gamma" amplitude="0" exponent="1" offset="0" />
      <feFuncB type="gamma" amplitude="0" exponent="1" offset="0.5" />
    </feComponentTransfer>
    <feGaussianBlur in="turbulence" stdDeviation="3" result="softMap" />
    <feSpecularLighting
      in="softMap"
      surfaceScale="5"
      specularConstant="1"
      specularExponent="100"
      lighting-color="white"
      result="specLight"
    >
      <fePointLight x="-200" y="-200" z="300" />
    </feSpecularLighting>
    <feComposite
      in="specLight"
      operator="arithmetic"
      k1="0"
      k2="1"
      k3="1"
      k4="0"
      result="litImage"
    />
    <feDisplacementMap
      in="SourceGraphic"
      in2="softMap"
      scale="200"
      xChannelSelector="R"
      yChannelSelector="G"
    />
  </filter>
</svg>
<div class="liquidGlass-wrapper nav-glass" data-nav-blur aria-hidden="true">
  <!-- Blur + máscara = degradado natural. Distorsión solo en zona superior (mask rompe el SVG filter). -->
  <div class="nav-glass__blur"></div>
  <div class="liquidGlass-effect nav-glass__distort"></div>
</div>
<header id="site-nav" class="site-nav fixed inset-x-0 top-0 z-50" data-nav>
  <nav class="page-x nav-bar" aria-label="Primary">
    <button
      type="button"
      class="nav-toggle"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Abrir menú"
    >
      <span class="nav-toggle__icon" aria-hidden="true">
        <span class="nav-toggle__line"></span>
        <span class="nav-toggle__line"></span>
      </span>
    </button>

    <div class="nav-menu" data-nav-menu id="nav-menu" aria-hidden="true">
      <ul class="nav-menu__list">
        {
          nav.map((item, index) => (
            <li class="nav-menu__item">
              <a
                href={item.href}
                data-nav-link
                data-nav-label={item.label}
                class="nav-link nav-menu__link font-pixel"
              >
                <span class="nav-menu__index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="nav-link__slot">
                  <span class="nav-link__ghost" aria-hidden="true">{item.label}</span>
                  <span class="nav-link__static">{item.label}</span>
                  <span class="nav-link__live" aria-hidden="true">
                    <span class="nav-link__typed"></span><span class="nav-link__cursor typewriter-cursor">|</span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="nav-menu__socials">
        {
          menuSocials.map((item) => (
            <a
              href={item.href}
              class="nav-menu__social-link"
              aria-label={item.label}
              target={item.href.startsWith("mailto:") ? undefined : "_blank"}
              rel={item.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
            >
              <img src={item.icon} alt="" width="40" height="40" loading="lazy" decoding="async" />
            </a>
          ))
        }
      </div>
    </div>
  </nav>
</header>

<style>
  .nav-glass-svg {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  /* Misma altura que el nav. Degradado natural vía mask en el blur (sin bandas). */
  .liquidGlass-wrapper.nav-glass {
    --nav-glass-h: 4.5rem;
    position: fixed;
    z-index: 49;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-glass-h);
    display: block;
    overflow: hidden;
    pointer-events: none;
    background: transparent;
    box-shadow: none;
    border: none;
    border-radius: 0;
    transition: opacity 0.35s ease;
  }

  .nav-glass__blur {
    position: absolute;
    inset: 0;
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    -webkit-mask-image: linear-gradient(
      180deg,
      #000 0%,
      #000 42%,
      rgba(0, 0, 0, 0.75) 58%,
      rgba(0, 0, 0, 0.4) 74%,
      rgba(0, 0, 0, 0.12) 88%,
      transparent 100%
    );
    mask-image: linear-gradient(
      180deg,
      #000 0%,
      #000 42%,
      rgba(0, 0, 0, 0.75) 58%,
      rgba(0, 0, 0, 0.4) 74%,
      rgba(0, 0, 0, 0.12) 88%,
      transparent 100%
    );
  }

  .nav-glass__distort {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 58%;
    overflow: hidden;
    isolation: isolate;
    background: transparent;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    filter: url(#glass-distortion);
    -webkit-filter: url(#glass-distortion);
    /* Sin mask aquí: el SVG filter la anula; el fade natural lo lleva el blur */
  }

  .nav-glass.is-hidden {
    opacity: 0;
    visibility: hidden;
  }

  .nav-bar {
    --nav-pad-y: clamp(0.85rem, 2.4vh, 1.15rem);
    position: relative;
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: var(--nav-pad-y);
    padding-bottom: var(--nav-pad-y);
  }

  .nav-bar__brand {
    position: relative;
    z-index: 52;
    flex: 1;
    min-width: 0;
    font-size: clamp(1rem, 3.75vw, 1.5rem);
  }

  .nav-toggle {
    display: none;
    position: relative;
    z-index: 52;
    width: 2.75rem;
    height: 2.75rem;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .nav-toggle__icon {
    position: relative;
    display: block;
    width: 1.35rem;
    height: 0.9rem;
  }

  .nav-toggle__line {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transform-origin: center;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      top 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      bottom 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-toggle__line:first-child {
    top: 0;
  }

  .nav-toggle__line:last-child {
    bottom: 0;
  }

  .site-nav.is-menu-open .nav-toggle__line:first-child {
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
  }

  .site-nav.is-menu-open .nav-toggle__line:last-child {
    bottom: auto;
    top: 50%;
    transform: translateY(-50%) rotate(-45deg);
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .nav-menu__list {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 5vw, 3.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-menu__index {
    display: none;
  }

  .nav-menu__socials {
    display: none;
  }

  @media (min-width: 768px) {
    .nav-menu {
      margin-left: auto;
    }

    .nav-menu__link {
      font-size: 1.0625rem;
      letter-spacing: -0.05em;
      color: inherit;
      text-decoration: none;
    }
  }

  @media (max-width: 767px) {
    .nav-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .nav-menu {
      position: fixed;
      inset: 0;
      z-index: 51;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: stretch;
      padding: clamp(5.5rem, 14vh, 7rem) var(--page-x) clamp(2.5rem, 8vh, 4rem);
      background: rgba(8, 8, 8, 0.96);
      backdrop-filter: blur(18px) saturate(120%);
      -webkit-backdrop-filter: blur(18px) saturate(120%);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.35s ease, visibility 0.35s ease;
    }

    .site-nav.is-menu-open .nav-menu {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .site-nav.is-menu-open nav {
      color: #fff;
    }

    .nav-menu__list {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      width: 100%;
    }

    .nav-menu__item {
      width: 100%;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .nav-menu__item:last-child {
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .nav-menu__link {
      display: flex;
      align-items: center;
      gap: 1rem;
      width: 100%;
      padding-block: clamp(1.1rem, 3.5vh, 1.45rem);
      font-size: clamp(1.75rem, 8vw, 2.5rem);
      letter-spacing: -0.06em;
      text-transform: uppercase;
      color: #fff;
      text-decoration: none;
      transition: opacity 0.2s ease, transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
      opacity: 0;
      transform: translateY(0.75rem);
    }

    .site-nav.is-menu-open .nav-menu__link {
      opacity: 1;
      transform: translateY(0);
    }

    .site-nav.is-menu-open .nav-menu__item:nth-child(1) .nav-menu__link { transition-delay: 0.05s; }
    .site-nav.is-menu-open .nav-menu__item:nth-child(2) .nav-menu__link { transition-delay: 0.1s; }
    .site-nav.is-menu-open .nav-menu__item:nth-child(3) .nav-menu__link { transition-delay: 0.15s; }
    .site-nav.is-menu-open .nav-menu__item:nth-child(4) .nav-menu__link { transition-delay: 0.2s; }

    .nav-menu__link:active {
      opacity: 0.55;
    }

    .nav-menu__index {
      display: inline-block;
      min-width: 1.75rem;
      font-family: var(--font-zirena);
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      color: rgba(255, 255, 255, 0.42);
    }

    .nav-menu__link .nav-link__live {
      display: none;
    }

    .nav-menu__socials {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: clamp(2.25rem, 9vw, 3.5rem);
      width: 100%;
      margin-top: auto;
      padding-top: clamp(2rem, 6vh, 3rem);
      opacity: 0;
      transform: translateY(0.5rem);
      transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .site-nav.is-menu-open .nav-menu__socials {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 0.25s;
    }

    .nav-menu__social-link {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 4rem;
      height: 4rem;
      border-radius: 999px;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .nav-menu__social-link:active {
      opacity: 0.55;
      transform: scale(0.94);
    }

    .nav-menu__social-link img {
      display: block;
      width: clamp(2.15rem, 7.5vw, 2.75rem);
      height: clamp(2.15rem, 7.5vw, 2.75rem);
      filter: invert(1);
      opacity: 0.88;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-menu,
    .nav-menu__link,
    .nav-toggle__line,
    .liquidGlass-wrapper {
      transition: none;
    }

    .nav-menu__link {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { setupScrollNavLinks } from "../lib/scroll/navScroll";
  import { enableMobileScrollNormalizer, getLenis } from "../lib/scroll/initLenis";

  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const MOBILE_NAV_MQ = window.matchMedia("(max-width: 767px)");

  setupScrollNavLinks();

  const sleep = (ms: number, signal?: AbortSignal) =>
    new Promise<void>((resolve, reject) => {
      const id = window.setTimeout(resolve, ms);
      signal?.addEventListener(
        "abort",
        () => {
          window.clearTimeout(id);
          reject(new DOMException("aborted", "AbortError"));
        },
        { once: true },
      );
    });

  if (!reduceMotion) {
    document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]").forEach((link) => {
      const label = link.dataset.navLabel ?? "";
      const typedEl = link.querySelector<HTMLElement>(".nav-link__typed");
      let controller: AbortController | null = null;

      link.addEventListener("mouseenter", () => {
        if (!typedEl || !label || MOBILE_NAV_MQ.matches) return;
        controller?.abort();
        controller = new AbortController();
        const { signal } = controller;

        (async () => {
          link.classList.add("is-nav-hover");
          typedEl.textContent = "";
          for (const ch of label) {
            typedEl.textContent += ch;
            await sleep(55, signal);
          }
        })().catch(() => {});
      });

      link.addEventListener("mouseleave", () => {
        controller?.abort();
        controller = null;
        if (typedEl) typedEl.textContent = "";
        link.classList.remove("is-nav-hover");
      });
    });
  }

  const navEl = document.getElementById("site-nav");
  const blurEl = document.querySelector<HTMLElement>("[data-nav-blur]");

  const syncNavGlassHeight = () => {
    if (!navEl || !blurEl) return;
    const navH = navEl.getBoundingClientRect().height;
    blurEl.style.setProperty("--nav-glass-h", `${navH}px`);
  };

  syncNavGlassHeight();
  document.fonts?.ready.then(syncNavGlassHeight);
  const toggleBtn = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const menuEl = document.querySelector<HTMLElement>("[data-nav-menu]");
  let menuScrollY = 0;

  const setMenuOpen = (open: boolean) => {
    if (!navEl || !toggleBtn || !menuEl) return;
    if (navEl.classList.contains("is-menu-open") === open) return;

    navEl.classList.toggle("is-menu-open", open);
    blurEl?.classList.toggle("is-hidden", open);
    toggleBtn.setAttribute("aria-expanded", String(open));
    toggleBtn.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    menuEl.setAttribute("aria-hidden", String(!open));

    const lenis = getLenis();
    if (open) {
      menuScrollY = window.scrollY || document.documentElement.scrollTop || 0;
      lenis?.stop();
      ScrollTrigger.normalizeScroll(false);
      document.documentElement.classList.add("nav-menu-open");
      document.body.style.top = `-${menuScrollY}px`;
      return;
    }

    document.documentElement.classList.remove("nav-menu-open");
    document.body.style.top = "";
    window.scrollTo(0, menuScrollY);
    lenis?.start();
    if (MOBILE_NAV_MQ.matches) enableMobileScrollNormalizer();
  };

  const blockBackgroundScroll = (event: Event) => {
    if (!navEl?.classList.contains("is-menu-open")) return;
    event.preventDefault();
  };

  document.addEventListener("wheel", blockBackgroundScroll, { passive: false });
  document.addEventListener("touchmove", blockBackgroundScroll, { passive: false });

  toggleBtn?.addEventListener("click", () => {
    setMenuOpen(!navEl?.classList.contains("is-menu-open"));
  });

  menuEl?.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
    link.addEventListener("click", () => setMenuOpen(false), { capture: true });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenuOpen(false);
  });

  const handleViewportChange = () => {
    if (!MOBILE_NAV_MQ.matches) setMenuOpen(false);
    syncNavGlassHeight();
  };

  MOBILE_NAV_MQ.addEventListener("change", handleViewportChange);
  window.addEventListener("resize", handleViewportChange, { passive: true });
</script>
