---
---

<section
  id="contact"
  class="contact-scene scroll-mt-24"
  data-contact-section
  aria-label="Contact"
>
  <canvas class="contact-scene__canvas webgl" aria-hidden="true"></canvas>

  <div class="contact-scene__content page-x">
    <p class="contact-scene__intro">
      <span>Let's build together.</span>
      <span>Got a project in mind? Let's talk.</span>
    </p>
    <p class="hero-intro__lead hero-intro__lead--on-light contact-scene__lead font-pixel">
      <a
        href="mailto:alejandro@arkapp.es"
        class="contact-scene__mailto hero-intro__lead-line contact-scene__lead-line"
      >
        <span>Contact me</span>
        <img
          src="/right-up.png"
          alt=""
          class="contact-scene__arrow"
          width="96"
          height="96"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
      </a>
    </p>
  </div>
</section>

<style>
  .contact-scene {
    position: relative;
    z-index: 5;
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-top: calc(-1 * clamp(2.5rem, 8vh, 5rem));
    min-height: 100vh;
    min-height: 100dvh;
    border-radius: clamp(1.25rem, 2.5vw, 2rem) clamp(1.25rem, 2.5vw, 2rem) 0 0;
    background-color: #ffffff;
    box-shadow: 0 -18px 56px rgba(0, 0, 0, 0.14);
    overflow: hidden;
    will-change: transform;
  }

  .contact-scene__canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: block;
    background-color: #ffffff;
    opacity: 0;
  }

  .contact-scene__canvas.is-ready {
    opacity: 1;
  }

  .contact-scene__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding-top: clamp(2.5rem, 14vh, 20vh);
    padding-bottom: clamp(1.25rem, 3.5vh, 2rem);
    pointer-events: none;
  }

  .contact-scene__intro {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-zirena);
    font-size: clamp(1.3rem, 2.6vw, 1.75rem);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.04em;
    text-align: center;
    color: #0a0a0a;
  }

  .contact-scene__lead {
    width: 100%;
    margin-top: auto;
    font-family: var(--font-pixel);
    font-size: clamp(2.75rem, 12vw, 9rem);
    line-height: 0.92;
    letter-spacing: -0.16em;
    word-spacing: -0.12em;
    text-align: center;
    color: #0a0a0a;
  }

  .contact-scene__lead .hero-intro__lead-line {
    text-align: center;
  }

  .contact-scene__lead-line {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.5rem, 2vw, 1.25rem);
  }

  .contact-scene__mailto {
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    pointer-events: auto;
  }

  .contact-scene__arrow {
    width: clamp(3.5rem, 12vw, 8.5rem);
    height: auto;
    flex-shrink: 0;
    align-self: center;
    margin-top: 0.08em;
    transform: translate(0, 0);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .contact-scene__mailto:hover .contact-scene__arrow {
    animation: contact-arrow-bounce 0.75s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes contact-arrow-bounce {
    0% {
      transform: translate(0, 0) scale(1);
    }
    35% {
      transform: translate(0.55rem, -1.35rem) scale(1.08);
    }
    55% {
      transform: translate(0.22rem, -0.55rem) scale(1.02);
    }
    75% {
      transform: translate(0.48rem, -1.05rem) scale(1.05);
    }
    100% {
      transform: translate(0.42rem, -0.95rem) scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-scene {
      will-change: auto;
    }

    .contact-scene__arrow {
      transition: none;
      animation: none !important;
    }

    .contact-scene__mailto:hover .contact-scene__arrow {
      transform: none;
    }

    .contact-scene__canvas {
      opacity: 1;
    }
  }
</style>

<script>
  import { setupContactChapter } from "../lib/scroll/contactChapter";

  const section = document.querySelector<HTMLElement>("[data-contact-section]");
  const canvas = section?.querySelector<HTMLCanvasElement>(".contact-scene__canvas");

  let disposeContactChapter: (() => void) | undefined;

  if (section && canvas) {
    disposeContactChapter = setupContactChapter({ section, canvas });
  }

  document.addEventListener("astro:beforeunload", () => {
    disposeContactChapter?.();
  });
</script>
