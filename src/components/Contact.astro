---
import { site } from "../data/site";
---

<section
  id="contact"
  class="contact-scene scroll-mt-24"
  data-contact-section
  aria-label="Contact"
>
  <canvas class="contact-scene__canvas webgl" aria-hidden="true"></canvas>

  <div class="contact-scene__content page-x">
    <p class="chapter-mark">
      <span class="chapter-mark__index">04</span>
      Contact
    </p>
    <div class="contact-scene__main">
      <p class="contact-scene__intro">Let's build together.</p>
      <a class="contact-scene__mailto" href={`mailto:${site.email}`}>
        {site.email}
      </a>
      <a class="contact-scene__cta font-pixel" href={`mailto:${site.email}`}>
        &gt; Contact
      </a>
    </div>
    <footer class="contact-scene__bar">
      <nav class="contact-scene__links" aria-label="Social">
        {
          site.socials
            .filter((item) => item.href !== "#")
            .map((item) => (
              <a href={item.href} target="_blank" rel="noopener noreferrer">
                {item.label}
              </a>
            ))
        }
      </nav>
      <a class="contact-scene__top" href="#main">Back to top</a>
    </footer>
  </div>
</section>

<style>
  .contact-scene {
    position: relative;
    z-index: 5;
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-top: 0;
    min-height: 100vh;
    min-height: 100dvh;
    border-radius: 0;
    background-color: transparent;
    box-shadow: none;
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    will-change: transform;
  }

  @media (max-width: 767px) {
    .contact-scene {
      margin-top: 0;
    }
  }

  .contact-scene__canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: block;
    background-color: transparent;
    filter: invert(1);
    opacity: 0;
  }

  .contact-scene__canvas.is-ready {
    opacity: 1;
  }

  .contact-scene__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: space-between;
    padding-top: clamp(5.5rem, 12vh, 7rem);
    padding-bottom: clamp(1.25rem, 3vh, 1.75rem);
    pointer-events: none;
  }

  .contact-scene__main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    margin-top: auto;
    margin-bottom: clamp(1.25rem, 4vh, 2.5rem);
    max-width: 52rem;
  }

  .contact-scene__intro {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.5;
    letter-spacing: -0.011em;
    color: rgba(255, 255, 255, 0.62);
  }

  .contact-scene__mailto {
    color: #fff;
    font-family: var(--font-zirena);
    font-size: clamp(1.8rem, 4.8vw, 4.25rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.045em;
    text-decoration: none;
    text-transform: lowercase;
    pointer-events: auto;
  }

  .contact-scene__mailto:hover {
    opacity: 0.72;
  }

  .contact-scene__cta {
    margin-top: 0.35rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #fff;
    pointer-events: auto;
  }

  .contact-scene__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    font-family: var(--font-pixel);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    pointer-events: auto;
  }

  .contact-scene__links {
    display: flex;
    gap: 1.25rem;
  }

  .contact-scene__bar a {
    color: inherit;
    text-decoration: none;
  }

  .contact-scene__bar a:hover {
    color: #fff;
  }

  @media (max-width: 700px) {
    .contact-scene__bar {
      flex-wrap: wrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-scene {
      will-change: auto;
    }

    .contact-scene__canvas {
      opacity: 1;
    }
  }
</style>

<script>
  import { setupContactChapter } from "../lib/scroll/contactChapter";

  const section = document.querySelector<HTMLElement>("[data-contact-section]");
  const canvas = section?.querySelector<HTMLCanvasElement>(".contact-scene__canvas");

  let disposeContactChapter: (() => void) | undefined;

  if (section && canvas) {
    disposeContactChapter = setupContactChapter({ section, canvas });
  }

  document.addEventListener("astro:beforeunload", () => {
    disposeContactChapter?.();
  });
</script>
