---
import { site } from "../data/site";

const rows = [
  { left: site.firstName, right: site.lastName },
  { left: "Web", right: "Developer" },
];
---

<section class="name-reel" data-name-reel aria-label="Intro">
  <canvas class="name-reel__canvas webgl" aria-hidden="true"></canvas>
  <div class="name-reel__content page-x">
    <ol class="name-reel__list">
      {
        rows.map((row) => (
          <li class="name-reel__row" data-reel-row>
            <span class="name-reel__name">{row.left}</span>
            <span class="name-reel__name name-reel__name--right">{row.right}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .name-reel {
    position: relative;
    height: 100dvh;
    background: transparent;
    color: #fff;
    overflow: hidden;
  }

  .name-reel__canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    filter: invert(1);
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .name-reel__canvas {
      pointer-events: auto;
    }
  }

  .name-reel__canvas.is-ready {
    opacity: 0.92;
  }

  .name-reel__content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    padding-block: clamp(5.5rem, 12vh, 7rem) clamp(2rem, 6vh, 3.5rem);
    pointer-events: none;
  }

  .name-reel__list {
    display: flex;
    flex-direction: column;
    gap: clamp(0.35rem, 1.5vh, 0.8rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .name-reel__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.35rem 1rem;
    opacity: 0.28;
    transition: opacity 0.45s ease;
  }

  .name-reel__row.is-active {
    opacity: 1;
  }

  .name-reel__name {
    font-family: var(--font-zirena);
    font-size: clamp(2.6rem, 7.4vw, 6.5rem);
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }

  .name-reel__name--right {
    text-align: right;
  }

  @media (min-width: 900px) {
    .name-reel__row {
      column-gap: clamp(1rem, 2vw, 2rem);
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { initDitherGrid } from "../lib/dither-grid/initDitherGrid";
  import { isMobileViewport, MOBILE_HERO_DITHER_GRID } from "../lib/device";
  import { HERO_SCROLL_ID } from "../lib/scroll/scrollDirector";
  import { SCROLL_EVENTS } from "../lib/scroll/scrollConfig";

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>("[data-name-reel]");
  const canvas = section?.querySelector<HTMLCanvasElement>(".name-reel__canvas");
  const rows = section
    ? [...section.querySelectorAll<HTMLElement>("[data-reel-row]")]
    : [];
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const mobile = isMobileViewport();
  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

  const zoomForIndex = [0, 0.05, 0.1];

  const setActive = (index: number) => {
    rows.forEach((row, i) => row.classList.toggle("is-active", i === index));
  };

  if (reduceMotion) {
    setActive(0);
  } else if (section && canvas && rows.length) {
    setActive(0);

    const grid = initDitherGrid({
      canvas,
      imageUrl: "/dithering-object.jpg",
      initialProgress: 1,
      emitReadyEvent: false,
      clearBackground: true,
      enableMouseRepel: canHover,
      gridColumns: mobile ? MOBILE_HERO_DITHER_GRID : 360,
      gridRows: mobile ? MOBILE_HERO_DITHER_GRID : 360,
    });

    const applyProgress = (progress: number) => {
      const last = rows.length - 1;
      const index = Math.min(last, Math.floor(progress * rows.length));
      setActive(index);
      const cross = 1 / rows.length;
      const span = 0.16;
      const waveT = Math.min(1, Math.max(0, (progress - (cross - span)) / (span * 2)));
      grid.setFigureWave(waveT);
      grid.setScrollZoom(zoomForIndex[index] ?? 0.08);
    };

    ScrollTrigger.create({
      id: HERO_SCROLL_ID,
      trigger: section,
      start: "top top",
      end: mobile ? "+=170%" : "+=240%",
      pin: true,
      pinSpacing: true,
      anticipatePin: 1,
      onUpdate: (self) => {
        applyProgress(self.progress);
        if (self.progress >= 0.995) {
          window.dispatchEvent(new CustomEvent(SCROLL_EVENTS.heroComplete));
        }
      },
      onLeave: () => {
        window.dispatchEvent(new CustomEvent(SCROLL_EVENTS.heroComplete));
      },
    });

    applyProgress(0);
    window.dispatchEvent(new CustomEvent(SCROLL_EVENTS.heroReady));

    document.addEventListener("astro:beforeunload", () => {
      grid.dispose();
    });
  }
</script>
