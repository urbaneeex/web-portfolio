---
import { workProjects } from "../data/site";

const collageOrder = ["juan-cano", "arkapp", "angel-lavayen"];
const collage = [
  ...collageOrder.flatMap((id) => workProjects.filter((project) => project.id === id)),
  ...workProjects.filter((project) => !collageOrder.includes(project.id)),
];
---

<section id="work" class="work-board page-x scroll-mt-24" data-work-section aria-labelledby="work-heading">
  <h2 id="work-heading" class="chapter-mark work-board__title">
    <span class="chapter-mark__index">02</span>
    Works
  </h2>
  <div class="work-board__stage">
    <ul class="work-board__collage">
      {
        collage.map((project) => (
          <li class="work-card">
            <a
              class="work-card__link"
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="work-card__media" data-card-media>
                <img
                  class="work-card__image"
                  src={project.image}
                  alt={project.imageAlt}
                  width="1200"
                  height="750"
                  decoding="async"
                />
              </span>
              <span class="work-card__caption">
                <span class="work-card__title" data-card-title={project.title}>
                  <span class="work-card__slot">
                    <span class="work-card__ghost" aria-hidden="true">{project.title}</span>
                    <span class="work-card__static">{project.title}</span>
                    <span class="work-card__live" aria-hidden="true">
                      <span class="work-card__typed"></span>
                    </span>
                  </span>
                </span>
                <span class="work-card__kind font-pixel">{project.kind}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .work-board {
    position: relative;
    z-index: 3;
    padding-bottom: clamp(3.5rem, 8vh, 5.5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    background: transparent;
    color: #fff;
  }

  .work-board__title {
    position: relative;
    z-index: 2;
    padding-top: clamp(5.5rem, 12vh, 7rem);
  }

  .work-board__stage {
    position: relative;
    height: clamp(36rem, 78vh, 46rem);
    margin-top: clamp(0.5rem, 2vh, 1.25rem);
  }

  .work-board__collage {
    position: relative;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .work-card {
    position: absolute;
    width: 34%;
  }

  .work-card:nth-child(1) {
    left: 0;
    top: 16%;
    width: 44%;
    z-index: 1;
  }

  .work-card:nth-child(2) {
    left: 28%;
    top: 0;
    width: 42%;
    z-index: 2;
  }

  .work-card:nth-child(3) {
    right: 0;
    top: 22%;
    width: 42%;
    z-index: 1;
  }

  .work-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.18);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .work-card.is-work-hover .work-card__link,
  .work-card__link:hover {
    border-color: #fff;
    box-shadow: 0 0 0 1px #fff;
  }

  .work-card.is-work-hover .work-card__image,
  .work-card__link:hover .work-card__image {
    filter: grayscale(1) contrast(1.08) brightness(1.06);
  }

  .work-card__media {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .work-card__image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }

  :global(.work-card__media .work-preview__grid) {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(var(--grid-cols), 1fr);
    grid-template-rows: repeat(var(--grid-rows), 1fr);
    pointer-events: none;
  }

  :global(.work-card__media .work-preview__cell) {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
    font-family: var(--font-pixel);
    font-size: clamp(5px, 0.48vw, 8px);
    line-height: 1;
    color: #fff;
    opacity: 0;
    overflow: hidden;
    text-transform: lowercase;
  }

  :global(.work-card__media .work-preview__cell.is-active) {
    opacity: 1;
  }

  :global(.work-card__media .work-preview__cell.is-active.is-empty) {
    color: transparent;
    background-color: rgba(0, 0, 0, 0.72);
  }

  .work-card__caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.7rem 0.8rem 0.85rem;
  }

  .work-card__kind {
    flex-shrink: 0;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
  }

  .work-card__title {
    min-width: 0;
    font-family: var(--font-zirena);
    font-size: clamp(1.15rem, 1.8vw, 1.7rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .work-card__slot {
    position: relative;
    display: inline-block;
    max-width: 100%;
  }

  .work-card__ghost {
    visibility: hidden;
    user-select: none;
  }

  .work-card__static,
  .work-card__live {
    position: absolute;
    inset: 0;
    white-space: nowrap;
  }

  .work-card__live {
    opacity: 0;
    visibility: hidden;
  }

  .work-card.is-work-hover .work-card__static {
    visibility: hidden;
  }

  .work-card.is-work-hover .work-card__live {
    opacity: 1;
    visibility: visible;
  }

  .work-card.is-work-hover .work-card__typed {
    color: #000;
    background-color: #fff;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    padding: 0.04em 0.1em;
  }

  @media (max-width: 767px) {
    .work-board__stage {
      height: auto;
    }

    .work-board__collage {
      display: flex;
      flex-direction: column;
      gap: 0;
      height: auto;
    }

    .work-card,
    .work-card:nth-child(1),
    .work-card:nth-child(2),
    .work-card:nth-child(3) {
      position: relative;
      left: auto;
      right: auto;
      top: auto;
      width: 86%;
    }

    .work-card:nth-child(even) {
      margin-left: auto;
    }

    .work-card + .work-card {
      margin-top: -1.75rem;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { SCROLL_EVENTS, WORK_SCROLL } from "../lib/scroll/scrollConfig";
  import { WORK_GRID, WorkPreviewGrid } from "../lib/scroll/workPreviewGrid";

  const section = document.querySelector<HTMLElement>("[data-work-section]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let typewriter: gsap.core.Tween | null = null;
  const grids = new Map<HTMLElement, { grid: WorkPreviewGrid; tween: gsap.core.Tween | null }>();

  section?.querySelectorAll<HTMLElement>(".work-card").forEach((card) => {
    const title = card.querySelector<HTMLElement>("[data-card-title]");
    const typed = card.querySelector<HTMLElement>(".work-card__typed");
    const media = card.querySelector<HTMLElement>("[data-card-media]");
    const label = title?.dataset.cardTitle ?? "";
    if (!title || !typed || !media) return;

    const playSquares = () => {
      if (reduceMotion) return;
      let entry = grids.get(media);
      if (!entry) {
        entry = { grid: new WorkPreviewGrid(media), tween: null };
        grids.set(media, entry);
      }
      entry.tween?.kill();
      entry.grid.coverFully();
      entry.grid.startShuffleLoop();
      const state = { progress: 0 };
      entry.tween = gsap.to(state, {
        progress: 1,
        duration: WORK_GRID.switchDuration,
        ease: "none",
        repeat: -1,
        onUpdate: () => {
          entry?.grid.applyTransitionProgress(state.progress, true);
        },
      });
    };

    const stopSquares = () => {
      const entry = grids.get(media);
      if (!entry) return;
      entry.tween?.kill();
      entry.tween = null;
      entry.grid.revealFully();
    };

    const play = () => {
      typewriter?.kill();
      card.classList.add("is-work-hover");
      playSquares();
      if (reduceMotion) {
        typed.textContent = label;
        return;
      }
      typed.textContent = "";
      const state = { chars: 0 };
      typewriter = gsap.to(state, {
        chars: label.length,
        duration: WORK_SCROLL.typewriterDuration,
        ease: "power2.out",
        onUpdate: () => {
          typed.textContent = label.slice(0, Math.round(state.chars));
        },
        onComplete: () => {
          typed.textContent = label;
          typewriter = null;
        },
      });
    };

    const stop = () => {
      typewriter?.kill();
      typewriter = null;
      card.classList.remove("is-work-hover");
      typed.textContent = "";
      stopSquares();
    };

    card.addEventListener("mouseenter", play);
    card.addEventListener("mouseleave", stop);
    card.addEventListener("focusin", play);
    card.addEventListener("focusout", stop);
  });

  if (section) {
    section.classList.add("is-work-ready");
    window.setTimeout(() => {
      window.dispatchEvent(new CustomEvent(SCROLL_EVENTS.workReady));
    }, 0);
  }
</script>
