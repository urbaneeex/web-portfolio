---
import { skillGroups } from "../data/skills";

const indexLabel = (index: number) => String(index + 1).padStart(2, "0");
---

<section
  id="skills"
  class="skills-section page-x scroll-mt-24"
  data-skills-section
  aria-labelledby="skills-heading"
>
  <header class="skills-section__header">
    <p class="chapter-mark">
      <span class="chapter-mark__index">03</span>
      Skills
    </p>
    <h2 id="skills-heading" class="chapter-title skills-section__title">
      Always learning.<br />Always building.
    </h2>
  </header>

  <div class="skills-board">
    {
      skillGroups.map((group, groupIndex) => (
        <article class="skills-row" data-skills-row>
          <header class="skills-row__head">
            <span class="skills-row__index font-pixel">{indexLabel(groupIndex)}</span>
            <h3 class="skills-row__label" data-stack-title={group.label}>
              <span class="skills-row__slot">
                <span class="skills-row__ghost" aria-hidden="true">
                  {group.label}
                </span>
                <span class="skills-row__static">{group.label}</span>
                <span class="skills-row__live" aria-hidden="true">
                  <span class="skills-row__typed" />
                </span>
              </span>
            </h3>
          </header>
          <ul class="skills-row__tools">
            {group.items.map((name) => (
              <li>
                <span class="skills-tool">{name}</span>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>

<style>
  .skills-section {
    position: relative;
    z-index: 4;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    padding-top: clamp(5.5rem, 12vh, 7rem);
    padding-bottom: clamp(4.5rem, 10vh, 6.5rem);
    color: #fff;
  }

  .skills-section__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1rem, 2.5vh, 1.5rem);
  }

  .skills-section__title {
    max-width: 11em;
  }

  .skills-board {
    margin-top: clamp(2.75rem, 7vh, 4.5rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  }

  .skills-row {
    display: grid;
    grid-template-columns: minmax(8.5rem, 13.5rem) minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 3rem);
    align-items: start;
    padding: clamp(1.35rem, 3.2vh, 2.1rem) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }

  .skills-row__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
    padding-top: 0.15rem;
  }

  .skills-row__index {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  .skills-row__label {
    margin: 0;
    font-family: var(--font-zirena);
    font-size: clamp(1.7rem, 2.6vw, 2.55rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    color: #fff;
  }

  .skills-row__slot {
    position: relative;
    display: inline-block;
  }

  .skills-row__ghost {
    visibility: hidden;
    user-select: none;
  }

  .skills-row__static,
  .skills-row__live {
    position: absolute;
    inset: 0;
    white-space: nowrap;
  }

  .skills-row__live {
    opacity: 0;
    visibility: hidden;
  }

  .skills-row.is-skills-hover .skills-row__static {
    visibility: hidden;
  }

  .skills-row.is-skills-hover .skills-row__live {
    opacity: 1;
    visibility: visible;
  }

  .skills-row.is-skills-hover .skills-row__typed {
    color: #000;
    background-color: #fff;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    padding: 0.04em 0.08em;
  }

  .skills-row__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skills-tool {
    display: inline-block;
    padding: 0.48rem 0.72rem 0.52rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(0, 0, 0, 0.45);
    font-family: var(--font-sans);
    font-size: 0.92rem;
    line-height: 1.2;
    letter-spacing: -0.011em;
    color: rgba(255, 255, 255, 0.82);
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .skills-tool:hover {
    border-color: #fff;
    background: #fff;
    color: #000;
  }

  @media (max-width: 700px) {
    .skills-section__title {
      max-width: none;
    }

    .skills-row {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skills-tool {
      transition: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { WORK_SCROLL } from "../lib/scroll/scrollConfig";

  const section = document.querySelector<HTMLElement>("[data-skills-section]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let typewriter: gsap.core.Tween | null = null;

  section?.querySelectorAll<HTMLElement>("[data-skills-row]").forEach((row) => {
    const title = row.querySelector<HTMLElement>("[data-stack-title]");
    const typed = row.querySelector<HTMLElement>(".skills-row__typed");
    const label = title?.dataset.stackTitle ?? "";
    if (!title || !typed || !label) return;

    const play = () => {
      typewriter?.kill();
      row.classList.add("is-skills-hover");
      if (reduceMotion) {
        typed.textContent = label;
        return;
      }
      typed.textContent = "";
      const state = { chars: 0 };
      typewriter = gsap.to(state, {
        chars: label.length,
        duration: WORK_SCROLL.typewriterDuration,
        ease: "power2.out",
        onUpdate: () => {
          typed.textContent = label.slice(0, Math.round(state.chars));
        },
        onComplete: () => {
          typed.textContent = label;
          typewriter = null;
        },
      });
    };

    const stop = () => {
      typewriter?.kill();
      typewriter = null;
      row.classList.remove("is-skills-hover");
      typed.textContent = "";
    };

    row.addEventListener("mouseenter", play);
    row.addEventListener("mouseleave", stop);
  });

  document.addEventListener("astro:beforeunload", () => {
    typewriter?.kill();
  });
</script>
