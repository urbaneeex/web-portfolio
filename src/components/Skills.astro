---
import { skillStacks, skillIconSrc } from "../data/skills";

const initialStack = skillStacks[0];
---

<section
  id="skills"
  class="skills-section page-x scroll-mt-24"
  data-skills-section
  aria-labelledby="skills-heading"
>
  <div class="skills-section__tour-track" data-skills-tour-track>
    <div class="skills-section__tour-stage" data-skills-tour-stage>
      <header class="skills-section__header">
        <h2 id="skills-heading" class="skills-section__title">
          <span class="skills-section__title-text">
            <span class="skills-section__rest">Always learning. Always </span><span class="skills-section__accent font-pixel">building</span><span class="skills-section__rest">.</span>
          </span>
        </h2>
      </header>

      <div class="skills-stack">
        <div class="skills-stack__stage">
          {
            skillStacks.map((stack, stackIndex) => (
              <ul
                class="skills-stack__icons"
                data-skills-icon-layer
                data-stack-index={stackIndex}
                aria-label={`${stack.label} tools`}
                style={stackIndex === 0 ? undefined : { opacity: 0 }}
              >
                {
                  stack.icons.map((icon, index) => (
                    <li
                      class="skills-stack__icon"
                      style={{
                        "--x": `${icon.x}%`,
                        "--y": `${icon.y}%`,
                        "--scale": icon.scale ?? 1,
                        "--rotate": `${icon.rotate ?? 0}deg`,
                        "--float-delay": `${index * 0.35}s`,
                      }}
                    >
                      <span class="skills-stack__icon-inner">
                        <img
                          src={skillIconSrc(icon.icon)}
                          alt={icon.name}
                          width={48}
                          height={48}
                          loading="lazy"
                          decoding="async"
                          title={icon.name}
                        />
                      </span>
                    </li>
                  ))
                }
              </ul>
            ))
          }

          <h3 class="skills-stack__label font-pixel" data-skills-label>
            {initialStack.label}
          </h3>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .skills-section {
    position: relative;
    z-index: 4;
    border: none;
    background-color: transparent;
    color: #fff;
    opacity: 0;
    will-change: transform, opacity;
  }

  .skills-section.is-skills-entering,
  .skills-section.is-skills-ready {
    visibility: visible;
    pointer-events: auto;
  }

  .skills-section.is-skills-ready {
    opacity: 1;
    will-change: auto;
  }

  .skills-section:not(.is-skills-ready):not(.is-skills-entering) {
    visibility: hidden;
    pointer-events: none;
  }

  .skills-section__tour-track {
    position: relative;
  }

  .skills-section__tour-stage {
    position: sticky;
    top: 0;
    z-index: 1;
    box-sizing: border-box;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(5rem, 11vh, 6.5rem) 0 clamp(3rem, 6vh, 4rem);
  }

  .skills-section.is-skills-tour-active .skills-section__tour-stage {
    height: 100dvh;
    min-height: 100dvh;
  }

  .skills-section__header {
    display: flex;
    justify-content: center;
    text-align: center;
    margin-bottom: clamp(2rem, 5vh, 3rem);
    flex-shrink: 0;
  }

  .skills-section__title {
    margin: 0;
    font-size: clamp(1.9rem, 4.35vw, 3rem);
    line-height: 1.35;
    letter-spacing: -0.045em;
    color: #fff;
    text-align: center;
  }

  .skills-section__title-text {
    display: inline-block;
    white-space: nowrap;
  }

  .skills-section__accent {
    font-style: italic;
    letter-spacing: -0.17em;
    word-spacing: -0.18em;
    -webkit-text-stroke: 0.35px currentColor;
    paint-order: stroke fill;
  }

  .skills-section__rest {
    font-family: var(--font-zirena);
    font-weight: 500;
    letter-spacing: -0.045em;
  }

  .skills-stack {
    flex: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 88rem;
    min-height: 0;
    margin-inline: auto;
  }

  .skills-stack__stage {
    position: relative;
    flex: 1;
    width: 100%;
    min-height: clamp(16rem, 42vh, 28rem);
    display: grid;
    place-items: center;
  }

  .skills-stack__label {
    position: relative;
    z-index: 3;
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.08em;
    color: #fff;
    text-align: center;
    pointer-events: none;
  }

  .skills-stack__icons {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .skills-stack__icons.is-stack-transitioning .skills-stack__icon-inner {
    animation: none;
    will-change: transform, opacity, filter;
  }

  .skills-stack__icon {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
  }

  .skills-stack__icon-inner {
    display: block;
    transform: rotate(var(--rotate)) scale(var(--scale));
    animation: skills-icon-float 5.5s ease-in-out infinite;
    animation-delay: var(--float-delay);
    will-change: transform;
  }

  .skills-stack__icon img {
    display: block;
    width: clamp(2.5rem, 4.8vw, 3.75rem);
    height: clamp(2.5rem, 4.8vw, 3.75rem);
    object-fit: contain;
    opacity: 0.88;
    filter: drop-shadow(0 0 22px rgba(255, 255, 255, 0.1));
  }

  @keyframes skills-icon-float {
    0%,
    100% {
      transform: rotate(var(--rotate)) scale(var(--scale)) translateY(0);
    }
    50% {
      transform: rotate(var(--rotate)) scale(var(--scale)) translateY(-0.65rem);
    }
  }

  @media (max-width: 640px) {
    .skills-section__tour-stage {
      padding-block: clamp(4.5rem, 12vh, 5.5rem) clamp(2.5rem, 5vh, 3rem);
    }

    .skills-section__title {
      font-size: clamp(1.35rem, 5.2vw, 1.9rem);
    }

    .skills-stack__stage {
      min-height: clamp(14rem, 38vh, 20rem);
    }

    .skills-stack__icon img {
      width: clamp(2.4rem, 8.5vw, 3.15rem);
      height: clamp(2.4rem, 8.5vw, 3.15rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skills-section {
      opacity: 1;
      will-change: auto;
      visibility: visible;
      pointer-events: auto;
    }

    .skills-stack__icon-inner {
      animation: none;
    }
  }
</style>

<script>
  import { setupSkillsChapter } from "../lib/scroll/skillsChapter";

  const section = document.querySelector<HTMLElement>("[data-skills-section]");
  const trackEl = section?.querySelector<HTMLElement>("[data-skills-tour-track]");
  const stageEl = section?.querySelector<HTMLElement>("[data-skills-tour-stage]");
  const labelEl = section?.querySelector<HTMLElement>("[data-skills-label]");
  const layers = [
    ...section?.querySelectorAll<HTMLElement>("[data-skills-icon-layer]") ?? [],
  ];

  let disposeSkillsChapter: (() => void) | undefined;

  if (section && trackEl && stageEl && labelEl && layers.length > 0) {
    disposeSkillsChapter = setupSkillsChapter({
      section,
      trackEl,
      stageEl,
      labelEl,
      layers,
    });
  }

  document.addEventListener("astro:beforeunload", () => {
    disposeSkillsChapter?.();
  });
</script>
